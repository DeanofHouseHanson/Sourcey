@model IReadOnlyList<BuyList.Application.Import.RejectedRow>
<div class="table-responsive">
    <table class="table table-sm table-bordered align-middle">
        <thead class="table-light"><tr><th>Row</th><th>Retailer</th><th>URL</th><th>EAN</th><th>Price</th><th>Why it was rejected</th></tr></thead>
        <tbody>
        @foreach (var row in Model)
        {
            <tr>
                <td>@row.RowNumber</td>
                <td>@row.Get("retailer")</td>
                <td class="text-break">@row.Get("url")</td>
                <td>@row.Get("ean")</td>
                <td>@row.Get("price")</td>
                <td><ul class="mb-0 ps-3">@foreach (var reason in row.Reasons) { <li>@reason</li> }</ul></td>
            </tr>
        }
        </tbody>
    </table>
</div>
