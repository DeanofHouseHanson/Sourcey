@page
@using BuyList.Application.Formatting
@using BuyList.Application.Listing
@using BuyList.Application.Ranking
@using BuyList.Domain.Enums
@using BuyList.Web.Display
@model IndexModel
@{
    ViewData["Title"] = Model.Q.View == BuyListView.Bought ? "Bought" : "Buy List";
    var r = Model.Result;
    var p = Model.Pipeline;
    var q = Model.Q;
    var isList = q.View == BuyListView.List;
    var first = r.TotalRows == 0 ? 0 : (r.Page - 1) * r.PageSize + 1;
    var last = Math.Min(r.TotalRows, r.Page * r.PageSize);

    string Money(decimal v) => Gbp.Format(v);
    string Arrow(BuyListSort key)
    {
        var (s, d) = Model.EffectiveSort();
        return s == key ? (d ? " ▼" : " ▲") : "";
    }
    string Aria(BuyListSort key)
    {
        var (s, d) = Model.EffectiveSort();
        return s == key ? (d ? "descending" : "ascending") : "none";
    }
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h4 mb-0 me-2">@(isList ? "Buy List" : "Bought")</h1>
    <ul class="nav nav-pills small">
        <li class="nav-item"><a class="nav-link py-1 @(isList ? "active" : "")" href="@Model.With(("View", null), ("Page", null))">Buy List</a></li>
        <li class="nav-item"><a class="nav-link py-1 @(!isList ? "active" : "")" href="@Model.With(("View", "Bought"), ("Page", null))">Bought</a></li>
    </ul>
    <span class="text-body-secondary small ms-1">
        @r.TotalRows item@(r.TotalRows == 1 ? "" : "s")
        @if (r.LastCalculatedAt is { } calc) { <text>&middot; updated @TimeAgo.Format(calc, Model.Now)</text> }
    </span>
    <div class="ms-auto d-flex gap-2">
        <a class="btn btn-sm btn-outline-secondary" href="@Model.ExportHref" title="Download the current filtered list">Export CSV</a>
        <form method="post" asp-page-handler="Refresh" class="d-inline"
              onsubmit="@(Model.LiveKeepa ? $"return confirm('This refresh will use up to {Model.TokenCap} Keepa tokens. Continue?')" : "return true")">
            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
            <button class="btn btn-sm btn-primary" type="submit"
                    title="@(Model.LiveKeepa ? $"Looks up new products and refreshes old data from Keepa, spending at most {Model.TokenCap} tokens" : "Demo mode: no Keepa tokens are used")">Refresh now</button>
        </form>
    </div>
</div>

@if (Model.Message is not null)
{
    <div class="alert alert-info py-2" role="status">@Model.Message</div>
}

@if (isList)
{
    <form method="get" class="bl-panel bl-filters card card-body p-3 mb-3">
        <input type="hidden" name="Sort" value="@q.Sort" />
        <input type="hidden" name="Desc" value="@(q.Desc ? "true" : "false")" />
        <div class="row g-2 align-items-end">
            <div class="col-6 col-md-2 col-xl-1"><label for="MinRoi">Min ROI %</label><input id="MinRoi" name="MinRoi" type="number" step="any" class="form-control" value="@q.MinRoi" /></div>
            <div class="col-6 col-md-2 col-xl-1"><label for="MinNetProfit">Min profit £</label><input id="MinNetProfit" name="MinNetProfit" type="number" step="any" class="form-control" value="@q.MinNetProfit" /></div>
            <div class="col-6 col-md-2 col-xl-1"><label for="MinMonthlySales">Min sales/mo</label><input id="MinMonthlySales" name="MinMonthlySales" type="number" min="0" class="form-control" value="@q.MinMonthlySales" /></div>
            <div class="col-6 col-md-2 col-xl-1"><label for="MaxUnitCost">Max unit cost £</label><input id="MaxUnitCost" name="MaxUnitCost" type="number" step="any" min="0" class="form-control" value="@q.MaxUnitCost" /></div>
            <div class="col-6 col-md-2 col-xl-2">
                <label for="MaxRisk">Max risk</label>
                <select id="MaxRisk" name="MaxRisk" class="form-select">
                    <option value="">Any</option>
                    @foreach (var level in new[] { RiskLevel.High, RiskLevel.Medium, RiskLevel.Low, RiskLevel.VeryLow })
                    {
                        <option value="@level" selected="@(q.MaxRisk == level)">@RiskBadge.Label(level) or safer</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-2 col-xl-2">
                <label for="Retailer">Retailer</label>
                <select id="Retailer" name="Retailer" class="form-select">
                    <option value="">All</option>
                    @foreach (var name in r.Retailers) { <option value="@name" selected="@(q.Retailer == name)">@name</option> }
                </select>
            </div>
            <div class="col-6 col-md-2 col-xl-1">
                <label for="Status">Status</label>
                <select id="Status" name="Status" class="form-select">
                    <option value="">Active</option>
                    <option value="New" selected="@(q.Status == OpportunityStatus.New)">New</option>
                    <option value="Checked" selected="@(q.Status == OpportunityStatus.Checked)">Checked</option>
                    <option value="Ignored" selected="@(q.Status == OpportunityStatus.Ignored)">Ignored</option>
                </select>
            </div>
            <div class="col-6 col-md-2 col-xl-1">
                <label for="PageSize">Per page</label>
                <select id="PageSize" name="PageSize" class="form-select">
                    @foreach (var size in new[] { 25, 50, 100, 200 }) { <option value="@size" selected="@(q.SafePageSize == size)">@size</option> }
                </select>
            </div>
            <div class="col-12 col-xl-auto">
                <label class="d-block">Ranking</label>
                <div class="btn-group bl-seg" role="group" aria-label="Ranking">
                    <input type="radio" class="btn-check" name="Ranking" id="rk1" value="RiskAdjusted" checked="@(q.Ranking == RankingMode.RiskAdjusted)" />
                    <label class="btn btn-outline-secondary" for="rk1">Risk-adjusted</label>
                    <input type="radio" class="btn-check" name="Ranking" id="rk2" value="Raw" checked="@(q.Ranking == RankingMode.Raw)" />
                    <label class="btn btn-outline-secondary" for="rk2">Raw</label>
                </div>
            </div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3 mt-3">
            <div class="form-check mb-0">
                <input type="hidden" name="HideAmazon" value="false" />
                <input class="form-check-input" type="checkbox" id="HideAmazon" name="HideAmazon" value="true" checked="@q.HideAmazon" />
                <label class="form-check-label" for="HideAmazon">Hide Amazon on listing</label>
            </div>
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="HideFlagged" name="HideFlagged" value="true" checked="@q.HideFlagged" />
                <label class="form-check-label" for="HideFlagged" title="Gated, hazmat or IP-complaint-prone">Hide flagged</label>
            </div>
            <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="IncludeStale" name="IncludeStale" value="true" checked="@q.IncludeStale" />
                <label class="form-check-label" for="IncludeStale">Include stale prices (&gt; 24h, greyed out)</label>
            </div>
            <div class="ms-auto d-flex gap-2">
                <a class="btn btn-sm btn-outline-secondary" href="/">Reset</a>
                <button class="btn btn-sm btn-primary" type="submit">Apply</button>
            </div>
        </div>
    </form>

    @if (r.Hidden.Total > 0)
    {
        <p class="small text-body-secondary mb-2">
            Hidden by filters:
            @{ var parts = new List<string>();
               if (r.Hidden.LossMaking > 0) parts.Add($"{r.Hidden.LossMaking} below the minimum profit");
               if (r.Hidden.AmazonOnListing > 0) parts.Add($"{r.Hidden.AmazonOnListing} with Amazon on the listing");
               if (r.Hidden.Stale > 0) parts.Add($"{r.Hidden.Stale} with a stale price");
               if (r.Hidden.Ignored > 0) parts.Add($"{r.Hidden.Ignored} ignored");
               if (r.Hidden.Blocklisted > 0) parts.Add($"{r.Hidden.Blocklisted} blocklisted"); }
            @string.Join(" · ", parts)
        </p>
    }
}

@if (r.TotalRows == 0)
{
    <div class="card card-body bl-panel">
        @if (!isList)
        {
            <p class="mb-0">Nothing marked as bought yet. Set an item's status to <strong>Bought</strong> on the Buy List and it will appear here.</p>
        }
        else if (p.Offers == 0)
        {
            <h2 class="h6">No offers yet</h2>
            <p class="mb-2">The Buy List is built from supplier prices. Import a CSV to get started.</p>
            <div><a class="btn btn-sm btn-primary" asp-page="/Import/Index">Import prices</a></div>
        }
        else if (p.Opportunities == 0)
        {
            <h2 class="h6">@p.Offers offer@(p.Offers == 1 ? "" : "s") imported, but no opportunities yet</h2>
            <p class="mb-2">An opportunity needs an Amazon listing with a 90-day Buy Box price. Where the pipeline stands:</p>
            <ul class="mb-2">
                <li>@p.OffersMatched of @p.Offers offers matched to a product</li>
                @if (p.ProductsAwaitingLookup > 0) { <li><strong>@p.ProductsAwaitingLookup</strong> product(s) still need an Amazon lookup: press <em>Refresh now</em></li> }
                @if (p.ProductsAmbiguous > 0) { <li><strong>@p.ProductsAmbiguous</strong> map to multiple ASINs: <a asp-page="/Unresolved/Index">choose the right one</a></li> }
                @if (p.ProductsNotFound > 0) { <li>@p.ProductsNotFound not found on Amazon</li> }
                @if (p.ProductsWithoutBuyBoxPrice > 0) { <li>@p.ProductsWithoutBuyBoxPrice have no Buy Box price: no data</li> }
            </ul>
            @if (Model.LiveKeepa)
            {
                <p class="small text-body-secondary mb-0">Live Keepa is on: a refresh spends at most @Model.TokenCap tokens per run, so large imports take several refreshes.</p>
            }
            else
            {
                <p class="small text-body-secondary mb-0">Demo mode: <code>Keepa:UseFake</code> is true, so only the built-in sample products can be found. Set <code>Keepa__UseFake=false</code> and a key for real data.</p>
            }
        }
        else
        {
            <h2 class="h6">Nothing matches these filters</h2>
            <p class="mb-2">@p.Opportunities opportunit@(p.Opportunities == 1 ? "y exists" : "ies exist") but none pass the current filters.</p>
            <div><a class="btn btn-sm btn-outline-secondary" href="/">Reset filters</a></div>
        }
    </div>
}
else
{
    <div class="bl-table-wrap">
        <table class="table table-hover bl-table align-middle">
            <caption class="visually-hidden">Buy List, ranked by @(q.Ranking == RankingMode.Raw ? "raw" : "risk-adjusted") monthly profit</caption>
            <thead>
                <tr>
                    <th scope="col"></th>
                    <th scope="col" aria-sort="@Aria(BuyListSort.Title)"><a href="@Model.SortLink(BuyListSort.Title, false)">Product<span class="arrow">@Arrow(BuyListSort.Title)</span></a></th>
                    <th scope="col" class="num" aria-sort="@Aria(BuyListSort.Buy)"><a href="@Model.SortLink(BuyListSort.Buy, false)">Buy (inc VAT)<span class="arrow">@Arrow(BuyListSort.Buy)</span></a></th>
                    <th scope="col" aria-sort="@Aria(BuyListSort.Checked)"><a href="@Model.SortLink(BuyListSort.Checked, true)">Source · checked<span class="arrow">@Arrow(BuyListSort.Checked)</span></a></th>
                    <th scope="col" class="num" aria-sort="@Aria(BuyListSort.Avg)"><a href="@Model.SortLink(BuyListSort.Avg, true)">Amazon 90d avg<span class="arrow">@Arrow(BuyListSort.Avg)</span></a></th>
                    <th scope="col" class="num" aria-sort="@Aria(BuyListSort.Profit)"><a href="@Model.SortLink(BuyListSort.Profit, true)">Net profit<span class="arrow">@Arrow(BuyListSort.Profit)</span></a></th>
                    <th scope="col" class="num" aria-sort="@Aria(BuyListSort.Roi)"><a href="@Model.SortLink(BuyListSort.Roi, true)">ROI<span class="arrow">@Arrow(BuyListSort.Roi)</span></a></th>
                    <th scope="col" class="num" aria-sort="@Aria(BuyListSort.Sales)"><a href="@Model.SortLink(BuyListSort.Sales, true)">Sales/mo<span class="arrow">@Arrow(BuyListSort.Sales)</span></a></th>
                    <th scope="col" class="num" aria-sort="@Aria(BuyListSort.Monthly)"><a href="@Model.SortLink(BuyListSort.Monthly, true)">Est. £/mo<span class="arrow">@Arrow(BuyListSort.Monthly)</span></a></th>
                    <th scope="col" class="num" aria-sort="@Aria(BuyListSort.Adjusted)"><a href="@Model.SortLink(BuyListSort.Adjusted, true)">Risk-adj. £/mo<span class="arrow">@Arrow(BuyListSort.Adjusted)</span></a></th>
                    <th scope="col" aria-sort="@Aria(BuyListSort.Risk)"><a href="@Model.SortLink(BuyListSort.Risk, false)">Risk<span class="arrow">@Arrow(BuyListSort.Risk)</span></a></th>
                    <th scope="col" class="num" aria-sort="@Aria(BuyListSort.Days)"><a href="@Model.SortLink(BuyListSort.Days, false)">Days to sell<span class="arrow">@Arrow(BuyListSort.Days)</span></a></th>
                    <th scope="col" aria-sort="@Aria(BuyListSort.Fba)"><a href="@Model.SortLink(BuyListSort.Fba, false)">Competition<span class="arrow">@Arrow(BuyListSort.Fba)</span></a></th>
                    <th scope="col">Flags</th>
                    <th scope="col" class="num" aria-sort="@Aria(BuyListSort.MaxBuy)"><a href="@Model.SortLink(BuyListSort.MaxBuy, true)">Max buy<span class="arrow">@Arrow(BuyListSort.MaxBuy)</span></a></th>
                    <th scope="col" class="num" aria-sort="@Aria(BuyListSort.Qty)"><a href="@Model.SortLink(BuyListSort.Qty, true)">Qty<span class="arrow">@Arrow(BuyListSort.Qty)</span></a></th>
                    <th scope="col" aria-sort="@Aria(BuyListSort.Status)"><a href="@Model.SortLink(BuyListSort.Status, false)">Status<span class="arrow">@Arrow(BuyListSort.Status)</span></a></th>
                    <th scope="col">Links</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in r.Rows)
            {
                var noSales = row.MonthlySales is null;
                <tr class="@(row.IsStale ? "stale" : "")">
                    <td>
                        @if (row.ImageUrl is not null) { <img class="bl-thumb" src="@row.ImageUrl" alt="" loading="lazy" referrerpolicy="no-referrer" /> }
                        else { <div class="bl-thumb-empty" aria-hidden="true"></div> }
                    </td>
                    <td>
                        <span class="title" title="@row.Title">@(row.Title ?? Gbp.NoData)</span>
                        <span class="sub">@row.Brand @(row.Asin is null ? "" : "· " + row.Asin)</span>
                    </td>
                    <td class="num">@Money(row.BuyPriceIncVat)<span class="sub">@Money(row.BuyPriceExVat) ex VAT</span></td>
                    <td>
                        <a href="@row.SourceUrl" target="_blank" rel="noopener noreferrer">@row.Retailer</a>
                        <span class="sub">checked @TimeAgo.Format(row.CheckedAt, Model.Now)@if (row.IsStale) { <text> · <strong>stale</strong></text> }</span>
                    </td>
                    <td class="num">@Gbp.Format(row.Avg90BuyBox)</td>
                    <td class="num @(row.NetProfit < 0 ? "neg" : "pos")">@Money(row.NetProfit)<span class="sub">@row.MarginPercent.ToString("0.#")% margin</span></td>
                    <td class="num @(row.RoiPercent < 0 ? "neg" : "")">@row.RoiPercent.ToString("0.#")%</td>
                    <td class="num">@if (noSales) { <span class="nodata">@Gbp.NoData</span> } else { @row.MonthlySales!.Value.ToString("N0") }</td>
                    <td class="num">@if (noSales) { <span class="nodata">@Gbp.NoData</span> } else { @Money(row.EstMonthlyProfit) }</td>
                    <td class="num fw-semibold">@if (noSales) { <span class="nodata fw-normal">@Gbp.NoData</span> } else { @Money(row.RiskAdjustedMonthlyProfit) }</td>
                    <td><span class="@RiskBadge.Css(row.Risk)">@RiskBadge.Label(row.Risk)</span></td>
                    <td class="num">@if (row.DaysToSell is { } days) { @days.ToString("0.#") } else { <span class="nodata">@Gbp.NoData</span> }</td>
                    <td>
                        <span title="@(row.FbaSellerCountIsApprox ? "Approximate: Keepa had no FBA count, so this is all new offers" : "FBA sellers")">FBA @(row.FbaSellerCountIsApprox ? "~" : "")@row.FbaSellerCount</span>
                        @if (row.AmazonOnListing) { <span class="flag flag-amazon">Amazon</span> }
                    </td>
                    <td>
                        @if (row.Flags.HasFlag(OpportunityFlags.Gated)) { <span class="flag">Gated</span> }
                        @if (row.Flags.HasFlag(OpportunityFlags.Hazmat)) { <span class="flag">Hazmat</span> }
                        @if (row.Flags.HasFlag(OpportunityFlags.IpComplaintProne)) { <span class="flag">IP risk</span> }
                    </td>
                    <td class="num">@Money(row.MaxBuyPrice)</td>
                    <td class="num">@row.SuggestedQty</td>
                    <td>
                        <form method="post" asp-page-handler="Status">
                            <input type="hidden" name="id" value="@row.OpportunityId" />
                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                            <select name="status" class="form-select bl-status" aria-label="Status for @row.Title" onchange="this.form.submit()">
                                @foreach (var s in new[] { OpportunityStatus.New, OpportunityStatus.Checked, OpportunityStatus.Bought, OpportunityStatus.Ignored })
                                {
                                    <option value="@s" selected="@(row.Status == s)">@s</option>
                                }
                            </select>
                            <noscript><button class="btn btn-sm btn-outline-secondary mt-1" type="submit">Set</button></noscript>
                        </form>
                    </td>
                    <td class="links">
                        @if (AmazonLinks.AmazonUk(row.Asin) is { } amz) { <a href="@amz" target="_blank" rel="noopener noreferrer">Amazon</a> }
                        @if (AmazonLinks.Keepa(row.Asin) is { } kp) { <a href="@kp" target="_blank" rel="noopener noreferrer">Keepa</a> }
                        @if (AmazonLinks.SellerAmp(row.Asin) is { } sas) { <a href="@sas" target="_blank" rel="noopener noreferrer">SAS</a> }
                        <a href="@row.SourceUrl" target="_blank" rel="noopener noreferrer">Source</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <nav class="d-flex flex-wrap align-items-center justify-content-between mt-3" aria-label="Pages">
        <span class="small text-body-secondary">Showing @first–@last of @r.TotalRows</span>
        @if (r.TotalPages > 1)
        {
            var from = Math.Max(1, r.Page - 2);
            var to = Math.Min(r.TotalPages, r.Page + 2);
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(r.Page == 1 ? "disabled" : "")"><a class="page-link" href="@Model.With(("Page", (r.Page - 1).ToString()))">Previous</a></li>
                @for (var i = from; i <= to; i++)
                {
                    <li class="page-item @(i == r.Page ? "active" : "")"><a class="page-link" href="@Model.With(("Page", i.ToString()))">@i</a></li>
                }
                <li class="page-item @(r.Page == r.TotalPages ? "disabled" : "")"><a class="page-link" href="@Model.With(("Page", (r.Page + 1).ToString()))">Next</a></li>
            </ul>
        }
    </nav>
}
