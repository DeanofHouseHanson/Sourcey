@{
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    string Active(string prefix) => page.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>@ViewData["Title"] - Buy List</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark mb-3">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand fw-semibold" asp-page="/Index">Buy List</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav" aria-controls="nav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="nav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link @(page == "/Index" ? "active" : "")" asp-page="/Index">Buy List</a></li>
                        <li class="nav-item"><a class="nav-link @Active("/Import")" asp-page="/Import/Index">Import</a></li>
                        <li class="nav-item"><a class="nav-link @Active("/Unresolved")" asp-page="/Unresolved/Index">Unresolved</a></li>
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form method="post" asp-page="/Account/Logout" class="d-flex">
                            <button class="btn btn-sm btn-outline-secondary">Sign out (@User.Identity.Name)</button>
                        </form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <main role="main" class="container-fluid px-3 px-lg-4 pb-4">
        @RenderBody()
    </main>
    <footer class="footer text-body-secondary border-top border-secondary-subtle">
        <div class="container-fluid px-3 px-lg-4">Buy List &middot; personal use</div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
