{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "System.Net.Http.HttpClient": "Warning" }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "BuyList": "Data Source=buylist.db" },

  "Seed": { "OnStartup": false },

  "Auth": {
    "Username": "admin"
  },

  "Keepa": {
    "UseFake": true,
    "BaseUrl": "https://api.keepa.com/",
    "DomainId": 2,
    "RefreshAgeHours": 24,
    "MinTokensReserve": 20,
    "BatchSize": 20,
    "TokensPerProduct": 3,
    "MaxTokensPerRun": 100,
    "UnresolvedRetryDays": 7,
    "RequestTimeoutSeconds": 60
  },

  "Profit": {
    "VatRegistered": true,
    "VatRate": 0.20,
    "InboundCostPerUnit": 0.50,
    "ReturnsAllowancePercent": 2,
    "TargetRoiPercent": 30,
    "ReferralFeePercent": 15
  },

  // APPROXIMATE placeholder FBA fees (ex VAT, by weight). Verify against Seller Central's rate card.
  "Fba": {
    "DefaultWeightGrams": 400,
    "Tiers": [
      { "Name": "Up to 100g",  "MaxWeightGrams": 100,  "Fee": 1.80 },
      { "Name": "Up to 250g",  "MaxWeightGrams": 250,  "Fee": 2.40 },
      { "Name": "Up to 500g",  "MaxWeightGrams": 500,  "Fee": 2.90 },
      { "Name": "Up to 1kg",   "MaxWeightGrams": 1000, "Fee": 3.40 },
      { "Name": "Up to 2kg",   "MaxWeightGrams": 2000, "Fee": 4.10 },
      { "Name": "Up to 5kg",   "MaxWeightGrams": 5000, "Fee": 5.60 }
    ]
  },

  "Risk": {
    "Bands": [
      { "MinMonthlySales": 0,   "Level": "VeryHigh", "Multiplier": 0.25 },
      { "MinMonthlySales": 10,  "Level": "High",     "Multiplier": 0.5 },
      { "MinMonthlySales": 30,  "Level": "Medium",   "Multiplier": 0.8 },
      { "MinMonthlySales": 100, "Level": "Low",      "Multiplier": 1.0 },
      { "MinMonthlySales": 300, "Level": "VeryLow",  "Multiplier": 1.0 }
    ]
  },

  "Ranking": {
    "BudgetPounds": 500,
    "StaleAfterHours": 24,
    "TargetDaysOfCover": 30,
    "MaxSuggestedQty": 50
  }
}
